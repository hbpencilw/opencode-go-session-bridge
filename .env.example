# opencode-go-session-bridge 环境变量示例
# 复制为 .env 或按需 export。代理零依赖、无必填项——全部可选，默认即可用。

# 监听端口（默认 14731；改端口后客户端 URL 需同步修改）
OPENCODE_GO_PROXY_PORT=14731

# 开启脱敏观测日志 capture.jsonl（排查用；只记头部名/路径/模型/结构/哈希，无 Key 无对话内容）
OPENCODE_GO_PROXY_CAPTURE=1

# 控制组：不注入会话头（仅用于 A/B 对照验证，验证注入是否生效）
# OPENCODE_GO_PROXY_NO_INJECT=1

# 数据目录（session-secret.key / capture.jsonl），默认与 proxy.mjs 同目录。
# ⚠️ 若项目位于 ~/Documents 等 macOS TCC 保护目录，且用 launchd 托管：
#    launchd 直接拉起的裸进程对保护目录无访问授权，第一个 fs.open 会无限挂起。
#    必须指向保护范围外，例如：
# OPENCODE_GO_PROXY_HOME=/Users/you/.local/state/opencode-go-session-bridge

# ─────────────────────────────────────────────────────────────
# 客户端侧（不是本代理读取的变量，供参考）
#   VS Code chatLanguageModels.json / Trae 自定义模型的 URL 指向：
#   http://127.0.0.1:14731/v1/chat/completions
#   API Key 使用各客户端自己的密钥管理（VS Code SecretStorage / Trae 输入框），
#   代理只透传 Authorization，从不落盘。
